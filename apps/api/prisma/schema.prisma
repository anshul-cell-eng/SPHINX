// ==============================================================================
// NEXUS Enterprise Architecture - Database Schema
// Multi-tenant PostgreSQL database specification (Supabase compatible)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// Core Tenancy
// ------------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PROVISIONING
  DEACTIVATED
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  domain      String?            @unique
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Tenant-scoped relations
  users       User[]
  departments Department[]
  incidents   Incident[]
  assets      Asset[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

// ------------------------------------------------------------------------------
// Identity & Workforce Management
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  OPERATIONS_MANAGER
  INCIDENT_RESPONDER
  STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

model User {
  id             String      @id @default(uuid())
  tenantId       String
  authUserId     String      @unique // References Supabase auth.users.id
  email          String
  firstName      String
  lastName       String
  role           UserRole    @default(STAFF)
  status         UserStatus  @default(INVITED)
  departmentId   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  reportedIncidents Incident[] @relation("IncidentReporter")
  assignedIncidents Incident[] @relation("IncidentAssignee")
  assignedAssets    Asset[]    @relation("AssetAssignee")
  auditLogs         AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([authUserId])
  @@map("users")
}

model Department {
  id           String       @id @default(uuid())
  tenantId     String
  name         String
  code         String
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members      User[]
  incidents    Incident[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

// ------------------------------------------------------------------------------
// Incident Operations Management
// ------------------------------------------------------------------------------

enum IncidentSeverity {
  SEV1_CRITICAL
  SEV2_HIGH
  SEV3_MEDIUM
  SEV4_LOW
}

enum IncidentPriority {
  P1_URGENT
  P2_HIGH
  P3_NORMAL
  P4_LOW
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
  CLOSED
}

model Incident {
  id             String           @id @default(uuid())
  tenantId       String
  incidentNumber String           // Format: INC-1001
  title          String
  description    String
  severity       IncidentSeverity @default(SEV3_MEDIUM)
  priority       IncidentPriority @default(P3_NORMAL)
  status         IncidentStatus   @default(OPEN)
  
  reporterId     String
  assigneeId     String?
  departmentId   String?
  
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reporter       User             @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee       User?            @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, incidentNumber])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@map("incidents")
}

// ------------------------------------------------------------------------------
// Asset Management
// ------------------------------------------------------------------------------

enum AssetStatus {
  OPERATIONAL
  MAINTENANCE
  DECOMMISSIONED
  LOST
}

model Asset {
  id               String       @id @default(uuid())
  tenantId         String
  assetTag         String       // e.g. AST-00942
  name             String
  type             String       // e.g. Server, Workstation, Network Switch, Cloud Instance
  status           AssetStatus  @default(OPERATIONAL)
  location         String?
  assignedToUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedToUser   User?        @relation("AssetAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, assetTag])
  @@index([tenantId])
  @@map("assets")
}

// ------------------------------------------------------------------------------
// Governance & Audit Trail
// ------------------------------------------------------------------------------

model AuditLog {
  id           String       @id @default(uuid())
  tenantId     String
  userId       String?
  action       String       // e.g. "INCIDENT_CREATED", "USER_INVITED"
  entityType   String       // e.g. "Incident", "User"
  entityId     String
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
