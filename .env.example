# ==============================================================================
# NEXUS Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or respective app .env files) for local development.
# Never commit actual secret keys or credentials to version control.

# Database (PostgreSQL / Supabase)
# DATABASE_URL: Transaction pooler connection string (Port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct database connection string for Prisma migrations (Port 5432)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth, Storage & Realtime
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER ONLY: Never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# API Server Configuration
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:5173

# Frontend Configuration (Exposed via Vite)
VITE_API_URL=http://localhost:4000/api/v1
