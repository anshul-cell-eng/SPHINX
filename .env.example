# ==============================================================
# FREELANCEOS — PRODUCTION ENVIRONMENT VARIABLES (Render.com)
# ==============================================================

# 1. Environment & Server Mode
NODE_ENV=production
# Render automatically injects PORT (e.g. 10000); defaults to 4000 locally
PORT=10000
API_PORT=4000

# 2. Public Frontend / Service URL
# Set this to the public HTTPS URL assigned to your Render Web Service
WEB_URL=https://your-freelanceos-app.onrender.com

# 3. Database Persistence (MongoDB Atlas)
# In MongoDB Atlas: Create cluster -> Database Access -> Network Access (0.0.0.0/0) -> Connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/freelanceos?retryWrites=true&w=majority

# 4. JWT Authentication Secrets
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_production_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_characters_here

# 5. Razorpay Payments Integration (Test Mode by default)
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Leave in Test Mode until production activation)
RAZORPAY_KEY_ID=rzp_test_9kM38Lp0QxWv12
RAZORPAY_KEY_SECRET=sec_test_7f920da8e14b
RAZORPAY_WEBHOOK_SECRET=whsec_test_99a8b7c6d5e4
