{
  "name": "freelanceos-platform",
  "version": "1.0.0",
  "private": true,
  "description": "FREELANCEOS — Premium Freelancer Business Operating System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@nexus/web",
    "dev:api": "npm run dev --workspace=@nexus/api",
    "dev:web": "npm run dev --workspace=@nexus/web",
    "build:web": "npm run build --workspace=@nexus/web",
    "build:api": "npm run build --workspace=@nexus/api",
    "build": "npm run build:web && npm run build:api",
    "start": "node apps/api/dist/server.js",
    "test:audit": "npm run test:audit --workspace=@nexus/api"
  }
}
